AddDefaultCharset UTF-8

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# Своя страница 404
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /index.html -> / (чистый адрес главной)
  RewriteRule ^index\.html$ / [R=301,L]

  # Существующие файлы и папки отдаём как есть
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Убираем завершающий слэш (кроме корня), если это не папка
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Чистые адреса без .html -> открываем соответствующий .html-файл
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML всегда свежий, чтобы после заливки сразу видны правки
  ExpiresByType text/html "access plus 0 seconds"
  # CSS и JS имеют метку ?v=... и меняются вместе с ней
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  # Картинки и шрифты: имена меняются редко, кэшируем надолго
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Долгий кэш для статичных картинок и шрифтов
  <FilesMatch "\.(avif|webp|jpe?g|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
