  "body_code": "<!-- Yandex.Metrika counter -->\n<script type=\"text/javascript\">\n    (function(m,e,t,r,i,k,a){\n        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};\n        m[i].l=1*new Date();\n        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}\n        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)\n    })(window, document,'script','https://mc.yandex.ru/metrika/tag.js', 'ym');\n\n    ym(94931472, 'init', {webvisor:true, clickmap:true, referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});\n</script>\n<noscript><div><img src=\"https://mc.yandex.ru/watch/94931472\" style=\"position:absolute; left:-9999px;\" alt=\"\" /></div></noscript>\n<!-- /Yandex.Metrika counter -->\n\n<script>\n/* Контактный попап вместо Re:plain: кнопки [data-contact-popup] и старые  */\n(function () {\n  function openContactPopup() {\n    var dlg = document.getElementById('contact-popup');\n    if (!dlg || !dlg.showModal) return;\n    if (dlg.open) return;\n    var x = window.scrollX, y = window.scrollY;\n    dlg.showModal();\n    window.scrollTo(x, y);\n    requestAnimationFrame(function () { window.scrollTo(x, y); });\n  }\n  document.addEventListener('click', function (e) {\n    var a = e.target && e.target.closest ? e.target.closest('[data-contact-popup]') : null;\n    if (!a) return;\n    e.preventDefault();\n    var inDlg = a.closest('dialog');\n    if (inDlg && inDlg.open && inDlg.id !== 'contact-popup') inDlg.close();\n    openContactPopup();\n  });\n  var dlg = document.getElementById('contact-popup');\n  if (dlg) {\n    dlg.addEventListener('click', function (e) {\n      if (e.target === dlg || e.target.closest('.cp__close')) dlg.close();\n    });\n  }\n})();\n"
