  "body_code": "<!-- Yandex.Metrika counter -->\n<script type=\"text/javascript\">\n    (function(m,e,t,r,i,k,a){\n        m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};\n        m[i].l=1*new Date();\n        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}\n        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)\n    })(window, document,'script','https://mc.yandex.ru/metrika/tag.js', 'ym');\n\n    ym(94931472, 'init', {webvisor:true, clickmap:true, referrer: document.referrer, url: location.href, accurateTrackBounce:true, trackLinks:true});\n</script>\n<noscript><div><img src=\"https://mc.yandex.ru/watch/94931472\" style=\"position:absolute; left:-9999px;\" alt=\"\" /></div></noscript>\n<!-- /Yandex.Metrika counter -->\n\n<script>\n/* Re:plain + Яндекс Метрика: clientID в чате, цели и открытие чата кнопками */\n(function () {\n  var COUNTER = 94931472;\n  var REPLAIN_ID = 'd6a46aec-a016-41c5-9dc4-13e0f685f1db';\n  var loaded = false;\n  var tries = 0;\n  var clientId = '';\n\n  function goal(name, params) {\n    if (typeof window.ym !== 'function') return;\n    var p = params || {};\n    if (!p.ym_client_id && clientId) p.ym_client_id = clientId;\n    window.ym(COUNTER, 'reachGoal', name, p);\n  }\n\n  /* Re:plain ищет старый API Метрики: Ya.Metrika.counters()[0].id\n     и yaCounter<ID>.reachGoal(). Делаем мостик на новый API ym(). */\n  window.Ya = window.Ya || {};\n  window.Ya.Metrika = window.Ya.Metrika || {};\n  if (typeof window.Ya.Metrika.counters !== 'function') {\n    window.Ya.Metrika.counters = function () { return [{ id: COUNTER }]; };\n  }\n  window['yaCounter' + COUNTER] = window['yaCounter' + COUNTER] || {\n    reachGoal: function (name, params) { goal(name, params); }\n  };\n\n  window.replainSettings = {\n    id: REPLAIN_ID,\n    fields: { ym_client_id: '' },\n    /* Свои цели в Метрике: Настройки → Цели → Целевое событие */\n    onClientSentMessage: function () { goal('ym-send-message'); },\n    onClientSentContactForm: function () { goal('ym-submit-contacts'); },\n    onClientSentRequestCallback: function () { goal('ym-send-request-callback'); }\n  };\n\n  /* Кнопки с href=\"#replain-link\" открывают чат — без платных дополнений Replain */\n  var pendingOpen = false;\n  var chatTries = 0;\n  function openChat() {\n    if (typeof window.ReplainAPI === 'function') {\n      try { window.ReplainAPI('open'); return; } catch (e) {}\n    }\n    pendingOpen = true;\n  }\n  document.addEventListener('click', function (e) {\n    var a = e.target && e.target.closest ? e.target.closest('a[href=\"#replain-link\"]') : null;\n    if (!a || a.hash !== '#replain-link') return;\n    e.preventDefault();\n    openChat();\n  });\n  var waitChat = setInterval(function () {\n    if (typeof window.ReplainAPI !== 'function') {\n      if (++chatTries > 100) clearInterval(waitChat);\n      return;\n    }\n    clearInterval(waitChat);\n    if (pendingOpen) { pendingOpen = false; try { window.ReplainAPI('open'); } catch (e) {} }\n  }, 200);\n\n  function setField(id) {\n    clientId = id || '';\n    window.replainSettings.fields.ym_client_id = clientId;\n    /* Если виджет уже загрузился — обновляем поле через JS API */\n    if (typeof window.ReplainAPI === 'function') {\n      try { window.ReplainAPI('setFields', { ym_client_id: clientId }); } catch (e) {}\n    }\n  }\n\n  function loadReplain() {\n    if (loaded) return;\n    loaded = true;\n    var s = document.createElement('script');\n    s.async = true;\n    s.src = 'https://widget.replain.cc/dist/client.js';\n    var x = document.getElementsByTagName('script')[0];\n    x.parentNode.insertBefore(s, x);\n  }\n\n  function start() {\n    if (typeof window.ym !== 'function') {\n      if (++tries > 50) { loadReplain(); return; }\n      setTimeout(start, 100);\n      return;\n    }\n    window.ym(COUNTER, 'getClientID', function (id) {\n      setField(id);\n      loadReplain();\n    });\n    /* Если колбэк не пришёл — всё равно показываем чат */\n    setTimeout(loadReplain, 2000);\n  }\n\n  start();\n})();\n</script>\n"
